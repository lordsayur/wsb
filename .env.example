# Shells (public, safe to ship): runtime reads Supabase only, cache first.
NUXT_PUBLIC_SUPABASE_URL=
NUXT_PUBLIC_SUPABASE_ANON_KEY=
# Browser extension build (same public values; injected by extension:build)
WSB_SUPABASE_URL=
WSB_SUPABASE_ANON_KEY=

# Importer only (service role bypasses RLS; never ship to a shell)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
