# Shells (public, safe to ship): runtime reads Supabase only, cache first.
NUXT_PUBLIC_SUPABASE_URL=
NUXT_PUBLIC_SUPABASE_ANON_KEY=
# Browser extension build (same public values; injected by extension:build)
WSB_SUPABASE_URL=
WSB_SUPABASE_ANON_KEY=

# Admin Google login (local `supabase start` only; hosted uses the dashboard).
# Callback registered in Google Cloud: http://127.0.0.1:54321/auth/v1/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Importer only (service role bypasses RLS; never ship to a shell)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Analytics (specs/analytics/spec.md). Build-time tag, not the hostname:
# production on Netlify, preview on deploy previews, development everywhere else.
NUXT_PUBLIC_ANALYTICS_ENV=development
# Opt in to sending from a dev server for a deliberate ingestion test.
NUXT_PUBLIC_ANALYTICS_DEV=

# Supabase CLI management token (deploy functions, patch auth config). Restored
# into ~/.supabase/access-token by .devcontainer postStartCommand on every
# container start, so a rebuild does not lose `supabase login`.
SUPABASE_ACCESS_TOKEN=
