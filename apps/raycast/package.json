{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "wsb-raycast",
  "title": "Brunei Prayer Times",
  "description": "Prayer times for Brunei and Muara, Tutong and Belait, right from your launcher.",
  "icon": "icon.png",
  "author": "lordsayur",
  "license": "MIT",
  "platforms": [
    "macOS"
  ],
  "categories": [
    "Productivity"
  ],
  "keywords": [
    "prayer",
    "sembahyang",
    "brunei",
    "waktu",
    "islam"
  ],
  "commands": [
    {
      "name": "prayer-times",
      "title": "View Prayer Times",
      "description": "Show today's prayer times for a district in Brunei.",
      "mode": "view"
    }
  ],
  "preferences": [
    {
      "name": "timeFormat",
      "title": "Time Format",
      "description": "Use a 24-hour or 12-hour clock.",
      "type": "dropdown",
      "required": false,
      "default": "24h",
      "data": [
        {
          "title": "24-hour",
          "value": "24h"
        },
        {
          "title": "12-hour",
          "value": "12h"
        }
      ]
    },
    {
      "name": "district",
      "title": "Default District",
      "description": "District selected when the command first opens.",
      "type": "dropdown",
      "required": false,
      "default": "bruneiMuara",
      "data": [
        {
          "title": "Brunei and Muara",
          "value": "bruneiMuara"
        },
        {
          "title": "Tutong",
          "value": "tutong"
        },
        {
          "title": "Belait",
          "value": "belait"
        }
      ]
    }
  ],
  "dependencies": {
    "@raycast/api": "^2.8.2",
    "react": "^19.0.0",
    "@wsb/core": "workspace:*",
    "@wsb/data": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.10",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  },
  "scripts": {
    "build": "node --env-file-if-exists=../../.env scripts/build.mjs",
    "typecheck": "node scripts/build.mjs --config-only && ray build -e dist -o dist --exit-on-error",
    "lint": "node scripts/build.mjs --config-only && ray lint",
    "test": "node scripts/build.mjs --config-only && vitest run",
    "dev": "node scripts/build.mjs --dev",
    "store:export": "node --env-file-if-exists=../../.env scripts/store.mjs"
  }
}
