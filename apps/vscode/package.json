{
  "name": "wsb-vscode",
  "displayName": "Waktu Sembahyang Brunei",
  "description": "Waktu sembahyang Brunei di bar status editor.",
  "version": "0.3.3",
  "license": "MIT",
  "publisher": "lordsayur",
  "private": true,
  "type": "module",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/lordsayur/wsb"
  },
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "wsb.openPanel",
        "title": "Waktu Sembahyang: Open times view"
      },
      {
        "command": "wsb.reloadData",
        "title": "Waktu Sembahyang: Reload data"
      }
    ],
    "configuration": {
      "title": "Waktu Sembahyang",
      "properties": {
        "wsb.statusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show the current entry and its time in the status bar."
        },
        "wsb.notifications": {
          "type": "boolean",
          "default": false,
          "description": "Show a notification 15 minutes before and at each prayer while VS Code is running."
        },
        "wsb.locale": {
          "type": "string",
          "default": "ms",
          "enum": [
            "ms",
            "ms-Arab",
            "ar",
            "en"
          ],
          "enumDescriptions": [
            "Bahasa Melayu",
            "\u0628\u0647\u0627\u0633 \u0645\u0644\u0627\u064a\u0648 (Jawi)",
            "\u0627\u0644\u0639\u0631\u0628\u064a\u0629",
            "English"
          ],
          "description": "Language for the status bar and times panel."
        },
        "wsb.timeFormat": {
          "type": "string",
          "default": "24h",
          "enum": [
            "24h",
            "12h"
          ],
          "enumDescriptions": [
            "24-hour",
            "12-hour"
          ],
          "description": "Clock format for times."
        },
        "wsb.district": {
          "type": "string",
          "default": "bruneiMuara",
          "enum": [
            "bruneiMuara",
            "tutong",
            "belait"
          ],
          "enumDescriptions": [
            "Brunei & Muara",
            "Tutong (+1 minute)",
            "Belait (+3 minutes)"
          ],
          "description": "District whose prayer times are shown."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "wsb",
          "title": "Waktu Sembahyang",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "wsb": [
        {
          "id": "wsb.times",
          "name": "Waktu Sembahyang",
          "type": "webview"
        }
      ]
    }
  },
  "scripts": {
    "build": "node --env-file-if-exists=../../.env scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "vscode:prepublish": "node --env-file-if-exists=../../.env scripts/build.mjs",
    "package": "vsce package --no-dependencies --out wsb-vscode.vsix"
  },
  "dependencies": {
    "@wsb/core": "workspace:*",
    "@wsb/data": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.96.0",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.28.2",
    "ovsx": "^1.3.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  },
  "icon": "media/icon.png"
}
